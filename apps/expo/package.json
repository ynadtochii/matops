{
  "name": "@matops/expo",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "dev": "expo start",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "mobile": "bash ./scripts/run-ios.sh",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "@expo-google-fonts/inter": "^0.4.2",
    "@matops/domain": "workspace:*",
    "@matops/ui": "workspace:*",
    "@matops/validators": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "better-auth": "catalog:",
    "expo": "~54.0.20",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "~6.0.16",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.13",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.8",
    "expo-web-browser": "~15.0.8",
    "nativewind": "5.0.0-preview.2",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-native": "~0.81.5",
    "react-native-css": "3.0.1",
    "react-native-safe-area-context": "~5.6.1",
    "react-native-screens": "~4.16.0",
    "superjson": "2.2.3"
  },
  "devDependencies": {
    "@matops/api": "workspace:*",
    "@matops/auth": "workspace:*",
    "@matops/eslint-config": "workspace:*",
    "@matops/prettier-config": "workspace:*",
    "@matops/tailwind-config": "workspace:*",
    "@matops/tsconfig": "workspace:*",
    "@types/react": "catalog:react19",
    "eslint": "catalog:",
