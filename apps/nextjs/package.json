{
  "name": "@matops/nextjs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm with-env next build",
    "e2e": "playwright test",
    "e2e:agent": "playwright-cli open http://127.0.0.1:3004 --headed",
    "e2e:headed": "playwright test --headed",
    "e2e:install": "playwright install chromium",
    "e2e:ui": "playwright test --ui",
    "vercel-build": "pnpm -F @matops/db migrate:deploy && pnpm run build",
    "clean": "git clean -xdf .cache .next .turbo node_modules",
    "dev": "pnpm with-env next dev -p 3004",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "start": "pnpm with-env next start",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@matops/api": "workspace:*",
    "@matops/auth": "workspace:*",
    "@matops/db": "workspace:*",
    "@matops/domain": "workspace:*",
    "@matops/notifications": "workspace:*",
    "@matops/ui": "workspace:*",
    "@matops/validators": "workspace:*",
    "@sentry/nextjs": "^10.70.0",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "better-auth": "catalog:",
    "next": "^16.0.9",
    "qrcode.react": "^4.2.0",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "superjson": "2.2.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@matops/eslint-config": "workspace:*",
    "@matops/prettier-config": "workspace:*",
    "@matops/tailwind-config": "workspace:*",
    "@matops/tsconfig": "workspace:*",
    "@playwright/cli": "^0.1.19",
    "@playwright/test": "^1.63.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "eslint": "catalog:",
    "jiti": "^2.5.1",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:"
  },
  "prettier": "@matops/prettier-config"
}
