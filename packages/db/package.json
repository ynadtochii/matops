{
  "name": "@matops/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./src/client.ts"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./src/schema.ts"
    },
    "./testing": {
      "types": "./test/helpers.ts",
      "default": "./test/helpers.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "check": "pnpm with-env drizzle-kit check",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "generate": "pnpm with-env drizzle-kit generate",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "migrate": "pnpm with-env drizzle-kit migrate",
    "push": "pnpm with-env drizzle-kit push",
    "seed": "pnpm with-env tsx src/seed/cli.ts",
    "seed:health": "pnpm with-env tsx src/seed.ts",
    "studio": "pnpm with-env drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@matops/domain": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.13.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@matops/eslint-config": "workspace:*",
    "@matops/prettier-config": "workspace:*",
    "@matops/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.5",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "^3.2.4"
  },
  "prettier": "@matops/prettier-config"
}
